---
layout: null
---
[
  {% for post in site.posts %}{% capture body %}{% include search-body.html post=post %}{% endcapture %}{
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.sent_time | date: "%Y-%m-%d" | jsonify }},
    "content": {{ body | strip | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
